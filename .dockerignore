# review-api's build context is the ROOT of this repository (build.sh runs
# `docker build ... .` here). The image needs pyproject.toml, README.md, src/
# and config/api.example.yaml, nothing else.
# mcp-server/ and scanner/ reach the build as NAMED build contexts
# (--build-context mcp-server=./mcp-server), which read their own
# .dockerignore, so they are left out of this one. scanner-worker/ is a
# separate image with its own context (scanner-worker/build.sh).
mcp-server/
scanner/
scanner-worker/
security-tests/
.git/
.venv/
venv/
reports/
docs/
tests/
examples/
k8s/
.claude/
build/
.pytest_cache/
**/__pycache__/
**/*.pyc
**/*.egg-info/
**/node_modules/

# Local secrets and scripts never belong in the image.
.env
*.ps1
*.sh

# A local config may point at private hosts; the image ships the example.
config/api.yaml
config/api.json
