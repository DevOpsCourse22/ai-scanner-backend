# Copy to .env and fill in only what you need:  cp .env.example .env
#
# .env is gitignored — it holds secrets and machine-specific values. Both
# docker compose and backend/config/api.yaml read these, so this one file is
# the only thing that differs between workstations.
#
# EVERY value here is optional. With an empty .env the project runs against a
# local LM Studio on the default port.

# ---------------------------------------------------------------------------
# 1. WHICH LLM ANSWERS THE REVIEW
# ---------------------------------------------------------------------------
# lmstudio           - on-prem, LM Studio running on THIS machine
# lmstudio_tailscale - LM Studio on a TEAMMATE's machine, over Tailscale
#                      (section 3b below) - no GPU needed on your side
# google_ai_studio   - cloud Gemma, needs GOOGLE_API_KEY below - no GPU either
# Others configured out of the box: lmstudio_fast, ollama, vllm, openai,
# groq, azure_openai.
REVIEW_API_DEFAULT_PROVIDER=lmstudio

# quick | brief | deep
REVIEW_API_DEFAULT_MODE=brief

# ---------------------------------------------------------------------------
# 2. CLOUD: GOOGLE AI STUDIO — the path when you have no local GPU
# ---------------------------------------------------------------------------
# Get a key: https://aistudio.google.com/apikey
# Then set REVIEW_API_DEFAULT_PROVIDER=google_ai_studio above.
GOOGLE_API_KEY=

# Leave blank to use the configured default. To see exactly which models your
# key can use, start the API and open:
#   http://localhost:8000/api/v1/health?probe=1&provider=google_ai_studio
GOOGLE_MODEL=

# ---------------------------------------------------------------------------
# 3. ON-PREM: LM STUDIO
# ---------------------------------------------------------------------------
# Running the API directly on the host (scripts/run-api):
#   http://localhost:1234/v1
# Running it in a container (docker compose) — the host is NOT localhost:
#   http://host.docker.internal:1234/v1   <- this is the compose default
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=google/gemma-4-26b-a4b-qat

# ---------------------------------------------------------------------------
# 3b. SHARED GPU OVER TAILSCALE — use the model on a teammate's machine
# ---------------------------------------------------------------------------
# THE ONLY LINE MOST TEAMMATES NEED TO CHANGE.
#
# Set REVIEW_API_DEFAULT_PROVIDER=lmstudio_tailscale above, then put the
# Tailscale address of the machine running LM Studio here. The owner of that
# machine gets it by running:   tailscale ip -4
# A MagicDNS name works too, e.g. gpu-box.tailnet-name.ts.net
#
# You need Tailscale installed and logged into the same tailnet
# (https://tailscale.com/download) — check with:  tailscale status
# Nothing is exposed to the public internet; only devices in the tailnet can
# reach it. Full walkthrough for both sides: docs/18-team-setup-guide.md 4c
TAILSCALE_LMSTUDIO_HOST=
# TAILSCALE_LMSTUDIO_PORT=1234       # only if LM Studio uses a custom port

# Other on-prem endpoints, if you use them.
# OLLAMA_BASE_URL=http://localhost:11434/v1
# VLLM_BASE_URL=http://vllm.internal:8000/v1
# VLLM_API_KEY=

# Other cloud providers, if you use them.
# OPENAI_API_KEY=
# GROQ_API_KEY=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_BASE_URL=

# ---------------------------------------------------------------------------
# 4. PRIVATE REPOSITORIES
# ---------------------------------------------------------------------------
# A GitHub personal access token used to clone PRIVATE repositories. Give it
# read-only repo scope and an expiry date. The token is passed to git through
# GIT_ASKPASS, so it never appears in a command line, a clone URL, a log, or a
# report. The MCP server accepts it ONLY from this environment variable —
# never as a tool argument, because that would put it in the chat transcript.
# The HTTP API can also take a per-request token in the request body instead.
GITHUB_TOKEN=

# ---------------------------------------------------------------------------
# 5. API SERVER
# ---------------------------------------------------------------------------
# Deterministic scanner tier (Semgrep/Gitleaks/Trivy), packaged separately
# as `repo_scanner` — pip install ./scanner. When installed it runs over the
# clone automatically and feeds its findings to the model, so findings_file
# becomes an advanced override instead of four manual steps. Harmless when
# the package is absent. Set to 0 to review without it.
# REVIEW_RUN_SCANNER=1

REVIEW_API_PORT=8000

# Host port for the test console (docker compose). Not 8080: the gateway
# uses that in the full local stack.
# REVIEW_CONSOLE_PORT=8090

# Shared secret. Empty = open, which is fine on localhost. SET THIS before
# exposing the API to anyone else; every /api/v1/* call must then send it as
# the X-API-Key header.
REVIEW_API_KEY=

# --- 5a. SHARING YOUR API WITH THE TEAM (host side) ------------------------
# Reports live on the machine that RUNS the API. A teammate running their own
# API sees their own (empty) reports folder — to see yours, they point their
# console at your API. That needs the API bound somewhere they can reach.
#
# Set BOTH of these together, to your Tailscale address:
#
#   REVIEW_API_BIND=100.83.14.22     # docker compose publishes here
#   REVIEW_API_HOST=100.83.14.22     # python -m review_api.app binds here
#
# Use your tailnet address, NOT 0.0.0.0: 100.x.y.z is reachable only by
# machines on your tailnet, while 0.0.0.0 also exposes the API on every
# other network this machine ever joins.
#
# `tailscale ip -4` prints the address. Windows also needs a firewall rule
# for the port — see docs/18-team-setup-guide.md §6.
#
# SET REVIEW_API_KEY ABOVE WHEN YOU DO THIS. An exposed API with no key lets
# anyone on the tailnet run reviews on your GPU, read every report and delete
# them. The server prints a warning at startup if you forget.
REVIEW_API_BIND=127.0.0.1
# REVIEW_API_HOST=127.0.0.1

# --- 5b. USING SOMEONE ELSE'S API (teammate side) --------------------------
# The address of the shared API. The example clients read this; in the demo
# console, type it into the API base box (a bare 100.x.y.z is enough — the
# console fills in http:// and :8000).
# REVIEW_API_URL=http://100.83.14.22:8000
